<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starsea.ai.mapper.DocumentChunkMapper">

    <resultMap id="DocumentChunkResultMap" type="com.starsea.ai.domain.DocumentChunk">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="publicId" column="public_id" jdbcType="OTHER" typeHandler="com.starsea.ai.auth.UuidTypeHandler"/>
        <result property="tenantId" column="tenant_id" jdbcType="BIGINT"/>
        <result property="knowledgeId" column="knowledge_id" jdbcType="BIGINT"/>
        <result property="fileId" column="file_id" jdbcType="BIGINT"/>
        <result property="position" column="position" jdbcType="INTEGER"/>
        <result property="content" column="content" jdbcType="LONGVARCHAR"/>
        <result property="overlapContent" column="overlap_content" jdbcType="LONGVARCHAR"/>
        <result property="overlapSourceChunkId" column="overlap_source_chunk_id" jdbcType="BIGINT"/>
        <result property="overlapTokenCount" column="overlap_token_count" jdbcType="INTEGER"/>
        <result property="indexContent" column="index_content" jdbcType="LONGVARCHAR"/>
        <result property="sectionPath" column="section_path" typeHandler="com.starsea.ai.openapi.credential.PostgresJsonbTypeHandler"/>
        <result property="sourceLocator" column="source_locator" typeHandler="com.starsea.ai.openapi.credential.PostgresJsonbTypeHandler"/>
        <result property="tokenCount" column="token_count" jdbcType="INTEGER"/>
        <result property="contentHash" column="content_hash" jdbcType="VARCHAR"/>
        <result property="boundaryReason" column="boundary_reason" typeHandler="com.starsea.ai.openapi.credential.PostgresJsonbTypeHandler"/>
        <result property="status" column="status" jdbcType="SMALLINT"/>
        <result property="isModified" column="is_modified" jdbcType="BOOLEAN"/>
        <result property="lastError" column="last_error" jdbcType="LONGVARCHAR"/>
        <result property="lockVersion" column="lock_version" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="findByFile" resultMap="DocumentChunkResultMap">
        SELECT *
        FROM document_chunk
        WHERE file_id = #{fileId}
          AND tenant_id = #{tenantId}
          AND knowledge_id = #{knowledgeId}
        ORDER BY position
    </select>

    <select id="findByFileForUpdate" resultMap="DocumentChunkResultMap">
        SELECT *
        FROM document_chunk
        WHERE file_id = #{fileId}
          AND tenant_id = #{tenantId}
          AND knowledge_id = #{knowledgeId}
        ORDER BY position
        FOR UPDATE
    </select>

    <delete id="deleteReplaceableDrafts">
        DELETE FROM document_chunk
        WHERE file_id = #{fileId}
          AND tenant_id = #{tenantId}
          AND knowledge_id = #{knowledgeId}
          AND status = 0
        <if test="replaceEditedDrafts == false">
          AND is_modified = FALSE
        </if>
    </delete>
</mapper>
