<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starsea.ai.mapper.FileMapper">

    <resultMap id="BaseResultMap" type="com.starsea.ai.domain.File">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="publicId" column="public_id"
                    typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <result property="fileName" column="file_name" jdbcType="VARCHAR"/>
            <result property="size" column="size" jdbcType="BIGINT"/>
            <result property="status" column="status" jdbcType="SMALLINT"/>
            <result property="type" column="type" jdbcType="VARCHAR"/>
            <result property="path" column="path" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <resultMap id="FileVoResultMap" type="com.starsea.ai.domain.vo.FileVo">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="fileName" column="file_name" jdbcType="VARCHAR"/>
        <result property="size" column="size" jdbcType="BIGINT"/>
        <result property="status" column="status" jdbcType="SMALLINT"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="pipelineState" column="pipeline_state" jdbcType="SMALLINT"/>
        <result property="progress" column="progress" jdbcType="SMALLINT"/>
        <result property="processingError" column="processing_error" jdbcType="LONGVARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,public_id,file_name,size,
        status,type,path,
        create_time,update_time
    </sql>

    <select id="selectByFileId" resultType="com.starsea.ai.domain.File">
        select * from file where id = #{id}
    </select>

    <select id="selectByKnowledgeId" resultMap="FileVoResultMap">
        SELECT f.id, f.file_name, f.size, f.status, f.type, f.create_time, f.update_time,
               fp.pipeline_state, fp.progress, fp.last_error AS processing_error
        FROM file f
        JOIN knowledge_file kf
          ON kf.file_id = f.id
         AND kf.tenant_id = #{tenantId}
         AND kf.knowledge_id = #{knowledgeId}
        JOIN file_processing fp
          ON fp.file_id = f.id
         AND fp.tenant_id = #{tenantId}
         AND fp.knowledge_id = #{knowledgeId}
        WHERE f.tenant_id = #{tenantId}
        ORDER BY f.id
    </select>

    <select id="selectEnabledByKnowledgeIds" resultMap="BaseResultMap">
        SELECT DISTINCT f.id, f.public_id, f.file_name, f.size, f.status, f.type,
                        f.path, f.create_time, f.update_time
        FROM file f
        JOIN knowledge_file kf
          ON kf.file_id = f.id
         AND kf.tenant_id = #{tenantId}
        JOIN knowledge k
          ON k.id = kf.knowledge_id
         AND k.tenant_id = #{tenantId}
        WHERE f.tenant_id = #{tenantId}
          AND f.status = 1
          AND kf.knowledge_id IN
        <foreach collection="knowledgeIds" item="knowledgeId" open="(" separator="," close=")">
            #{knowledgeId}
        </foreach>
        ORDER BY f.id
    </select>
</mapper>
