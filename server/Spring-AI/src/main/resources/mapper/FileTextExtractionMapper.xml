<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starsea.ai.mapper.FileTextExtractionMapper">
    <resultMap id="ExtractionResultMap" type="com.starsea.ai.domain.FileTextExtraction">
        <id property="fileId" column="file_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="sourceHash" column="source_hash"/>
        <result property="extractorId" column="extractor_id"/>
        <result property="extractorVersion" column="extractor_version"/>
        <result property="mediaType" column="media_type"/>
        <result property="managedTextPath" column="managed_text_path"/>
        <result property="sourceMapPath" column="source_map_path"/>
        <result property="characterCount" column="character_count"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findScoped" resultMap="ExtractionResultMap">
        SELECT * FROM file_text_extraction
        WHERE tenant_id = #{tenantId} AND file_id = #{fileId}
    </select>

    <update id="updateScoped">
        UPDATE file_text_extraction
        SET source_hash = #{sourceHash}, extractor_id = #{extractorId},
            extractor_version = #{extractorVersion}, media_type = #{mediaType},
            managed_text_path = #{managedTextPath}, source_map_path = #{sourceMapPath},
            character_count = #{characterCount}, update_time = CURRENT_TIMESTAMP
        WHERE tenant_id = #{tenantId} AND file_id = #{fileId}
    </update>
</mapper>
